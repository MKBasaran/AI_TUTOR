@using System.Threading
@using EDMOFrontend.Components.Controls
@using ServerCore.Tutor
@implements IDisposable

<div class="tutorCard">
    <div class="tutorHeader">
        <div class="tutorMeta">
            <span class="tutorLabel">Tutor</span>
            <span class="statusBadge @StatusClass">@StatusText</span>
        </div>
        <div class="tutorActions">
            <span class="budget">Hints: @HintBudget</span>
            @if (ReportAvailable)
            {
                <Button Enabled="@ReportEnabled" OnClick="HandleReportStuck">
                    @ReportLabel
                </Button>
            }
            <Button Enabled="@HintAvailable" OnClick="OnRequestHint">
                @HintButtonLabel
            </Button>
        </div>
    </div>

    <div class="tutorHint">
        <p>@HintText</p>
    </div>

    @if (ShowDirections)
    {
        <div class="tutorDirections">
            @foreach (var item in DirectionItems)
            {
                <span class="directionPill @DirectionClass(item.Direction)">
                    @item.Label: @DirectionText(item.Direction)
                </span>
            }
        </div>
    }
</div>

@code {
    private static readonly TimeSpan ReportCooldown = TimeSpan.FromSeconds(15);
    private CancellationTokenSource? reportCts;
    private bool reportInFlight;
    private bool reportCooldown;

    [Parameter] public TutorStatusResponse? Status { get; set; }
    [Parameter] public EventCallback OnRequestHint { get; set; }
    [Parameter] public EventCallback OnReportStuck { get; set; }

    private string StatusText => Status switch
    {
        null => "Waiting for trial data",
        { Stuck: true } => "Stuck detected",
        _ => "Progressing"
    };

    private string StatusClass => Status switch
    {
        null => "waiting",
        { Stuck: true } => "stuck",
        _ => "ok"
    };

    private string HintText
    {
        get
        {
            if (Status?.LastHint is not null)
                return Status.LastHint.Text;

            if (Status is null)
                return "Waiting for trial data. Try a few changes first.";

            return "Stuck? Ask for a hint!";
        }
    }

    private bool IsGlobalHintMode => string.Equals(Status?.HintMode, "global_majority", StringComparison.OrdinalIgnoreCase);
    private int HintVoteCount => Status?.HintVoteCount ?? 0;
    private int HintVoteTotal => Status?.HintVoteTotal ?? 0;

    private string HintButtonLabel => IsGlobalHintMode
        ? $"Get hint ({HintVoteCount}/{HintVoteTotal})"
        : "Get hint";

    private bool HintAvailable => Status?.HintAvailable == true;

    private bool ReportAvailable => Status is not null && !Status.Stuck;

    private bool ReportEnabled => ReportAvailable && !reportInFlight && !reportCooldown;

    private string ReportLabel => reportInFlight
        ? "Submitting..."
        : reportCooldown
            ? "Reported"
            : "Mark stuck";

    private int HintBudget => Status?.HintBudgetRemaining ?? 0;

    private bool ShowDirections => Status?.LastHint?.Tier is HintTier.Pattern
        && Status.LastHint.ParameterDirections.Count > 0;

    private IEnumerable<(string Label, ParameterDirection Direction)> DirectionItems
    {
        get
        {
            if (Status?.LastHint is null)
                yield break;

            var directions = Status.LastHint.ParameterDirections;
            foreach (var entry in OrderedKeys)
            {
                if (directions.TryGetValue(entry.Key, out var direction))
                    yield return (entry.Label, direction);
            }
        }
    }

    private static readonly (string Key, string Label)[] OrderedKeys =
    [
        ("speed", "Speed"),
        ("range", "Range"),
        ("baseline_position", "Baseline position"),
        ("relation", "Relation")
    ];

    private async Task HandleReportStuck()
    {
        if (!ReportEnabled)
            return;

        reportInFlight = true;
        await InvokeAsync(StateHasChanged);

        await OnReportStuck.InvokeAsync();

        reportInFlight = false;
        reportCooldown = true;
        await InvokeAsync(StateHasChanged);

        reportCts?.Cancel();
        reportCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(ReportCooldown, reportCts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        reportCooldown = false;
        await InvokeAsync(StateHasChanged);
    }

    private static string DirectionText(ParameterDirection direction)
        => direction switch
        {
            ParameterDirection.Increase => "Increase",
            ParameterDirection.Decrease => "Decrease",
            _ => "Keep"
        };

    private static string DirectionClass(ParameterDirection direction)
        => direction switch
        {
            ParameterDirection.Increase => "up",
            ParameterDirection.Decrease => "down",
            _ => "keep"
        };

    public void Dispose()
    {
        reportCts?.Cancel();
        reportCts?.Dispose();
    }
}
