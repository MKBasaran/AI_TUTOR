@implements IDisposable
@using System.Numerics

<div class="block">
    <div class="wheel" @onpointerdown="onMouseDown" id="demoRelationWheel">
        <span class="relationText">@((int)NormalizedAngle(Value))</span>
        <div class="dotRail" style="transform: rotate(@(NormalizedAngle(Value))deg)">
            <div class="dot" style="background-color: var(--baseTextColor)"></div>
        </div>
    </div>
</div>

<script>
    GetBoundingClientRectOfDemo = (elementID) => {
        return document.getElementById(elementID).getBoundingClientRect();
    };
    UnbindDemoMovementCallbacks = () => {
        document.onpointerup = null;
        document.onpointermove = null;
    }
    BindDemoMovementCallbacks = (dotnetObj) => {
        document.onpointermove = (args) => dotnetObj.invokeMethodAsync("OnMouseMove", args.clientX, args.clientY);
        document.onpointerup = UnbindDemoMovementCallbacks;
    }
</script>

@code {
    private DotNetObjectReference<DemoRelationWheel>? objRef;

    [Inject] public IJSRuntime JsRuntime { get; set; } = null!;

    [Parameter] public float Value { get; set; }
    [Parameter] public EventCallback<float> ValueChanged { get; set; }

    protected override Task OnInitializedAsync()
    {
        objRef = DotNetObjectReference.Create(this);
        return base.OnInitializedAsync();
    }

    private async Task onMouseDown(MouseEventArgs args)
    {
        if (args.Button is not 0)
            return;

        await JsRuntime.InvokeVoidAsync("BindDemoMovementCallbacks", objRef);
        await OnMouseMove(args.ClientX, args.ClientY);
    }

    [JSInvokable]
    public async Task OnMouseMove(double x, double y)
    {
        var rect = await JsRuntime.InvokeAsync<BoundingClientRect>("GetBoundingClientRectOfDemo", "demoRelationWheel");

        var minDim = Math.Min(rect.Width, rect.Height);
        var origin = new Vector2(rect.X + rect.Width / 2, rect.Y + rect.Height / 2);

        var mousePos = new Vector2((float)x, (float)y);

        double distanceSquared = Math.Pow(mousePos.X - origin.X, 2) + Math.Pow(mousePos.Y - origin.Y, 2);

        if (distanceSquared > Math.Pow(minDim / 2, 2) * 2)
            return;

        float angle = NormalizedAngle(GetDegreesFromPosition(origin, mousePos));
        int angleQuant = (int)Math.Round(angle);
        await ValueChanged.InvokeAsync(angleQuant);
    }

    private static float GetDegreesFromPosition(Vector2 origin, Vector2 target)
    {
        var direction = target - origin;
        float angle = (float)(Math.Atan2(direction.Y, direction.X) * 180 / Math.PI);
        return angle + 90;
    }

    private static float NormalizedAngle(float angle)
    {
        while (angle < 0)
            angle += 360;

        return angle % 360;
    }

    public void Dispose()
    {
        objRef?.Dispose();
    }

    public record BoundingClientRect
    {
        public float X { get; init; }
        public float Y { get; init; }
        public float Width { get; init; }
        public float Height { get; init; }
    }
}