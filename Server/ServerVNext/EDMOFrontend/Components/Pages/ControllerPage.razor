@page "/controller"
@implements IDisposable
@using System.Diagnostics
@using System.Threading
@using EDMOFrontend.Components.Controller
@using EDMOFrontend.Components.Controls
@using EDMOFrontend.Components.Layout
@using EDMOFrontend.Services
@using ServerCore.EDMO
@using ServerCore.EDMO.Objectives
@using ServerCore.Tutor

@*We specifically don't want to prerender this to avoid the server creating and disposal a session connection through multiple initialisation.*@
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<CascadingValue Value="@("controller")" Name="LocalisationBank">
    <CascadingValue Value="@controlContext" Name="ControlContext">
        <SplitView>
            <Left>
                <div class="viewportArea">
                    <TopBar>
                        <a title="Leave room" href="/" id="quitButton">
                            <i class="fa-solid fa-door-open icon"></i>
                        </a>
                        <TaskBubble ObjectiveGroups="objectiveGroups"/>
                    </TopBar>
                    @if (controlContext is not null)
                    {
                        <EDMOModelViewer/>
                    }
                </div>
            </Left>
            <Right>
                <Card>
                    @if (controlContext is not null)
                    {
                        <TabView tabIcon="tabIcons" tabContents="tabContent"/>
                    }
                    else
                    {
                        <div>
                            <h1>dYTU</h1>
                            <h2>
                                <LocalisableString TextKey="somethingWentWrong"
                                                   DefaultText="Something went wrong. Sorry about that."/>
                            </h2>
                            <h3>
                                <LocalisableString TextKey="incidentLogged"
                                                   DefaultText="This incident has been logged for future analysis."/>
                            </h3>
                            <br/>
                            <h3>
                                <LocalisableString TextKey="exceptionForOperator"
                                                   DefaultText="Exception content for operator:"/>
                            </h3>
                            <h4>@errorMessage</h4>
                        </div>
                    }
                </Card>
            </Right>
        </SplitView>
    </CascadingValue>
</CascadingValue>

<script>
    setupUnloadDisposal = (objRef) => {
        window.onbeforeunload = function (_) {
            objRef.invokeMethodAsync("Dispose");
        };
    }
</script>

@if (controlContext is not null)
{
    <style>
        :root {
            --hue:  @controlContext.AssignedHueOf(controlContext.Index)
        }
    </style>
}

@code{
    private DotNetObjectReference<ControllerPage>? objRef;
    private RenderFragment[] tabIcons = [];
    private RenderFragment?[] tabContent = [];

    private PeriodicTimer? tutorTimer;
    private CancellationTokenSource? tutorCts;
    private readonly SemaphoreSlim submitLock = new(1, 1);
    private int runCounter;
    private TutorStatusResponse? tutorStatus;

    [Inject] public IJSRuntime jsRuntime { get; set; }
    [Inject] public EDMOSessionManager sessionManager { get; set; }
    [Inject] public TutorManager TutorManager { get; set; } = null!;

    private EDMOSession.ControlContext? controlContext { get; set; } = null!;
    private EDMOObjectiveGroup[]? objectiveGroups = null;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        objRef = DotNetObjectReference.Create(this);

        try
        {
            controlContext = sessionManager.AttemptConnectionTo(SessionIdentifier, Name);
        }
        catch (Exception e)
        {
            errorMessage = e.ToString();
            return;
        }

        Debug.Assert(controlContext is not null);
        objectiveGroups = [..controlContext.ObjectiveGroups];
        tabIcons =
        [
            @<Icon Glyph="gamepad" FontSize="3rem">&nbsp;@controlContext.Index</Icon>,
            @<Icon Glyph="list" FontSize="3rem"/>,
            @<Icon Glyph="user-group" FontSize="3rem"/>
        ];
        tabContent =
        [
            @<div class="tutorStack">
                <SliderPanel/>
                <TutorPanel Status="tutorStatus" OnRequestHint="RequestHint" OnReportStuck="ReportStuck"/>
            </div>,
            @<TaskPanel ObjectiveGroups="[..controlContext.ObjectiveGroups]"/>,
            @<UserPanel/>
        ];

        tutorStatus = await TutorManager.GetStatusAsync(SessionIdentifier, LegId);
        StartTutorLoop();

        await base.OnInitializedAsync();
    }

    private string LegId => $"leg-{controlContext?.Index ?? 0}";

    private void StartTutorLoop()
    {
        tutorCts = new CancellationTokenSource();
        tutorTimer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        _ = Task.Run(() => SubmitLoopAsync(tutorCts.Token));
    }

    private async Task SubmitLoopAsync(CancellationToken token)
    {
        try
        {
            while (await tutorTimer!.WaitForNextTickAsync(token))
            {
                await SubmitTutorTrialAsync(token);
            }
        }
        catch (OperationCanceledException)
        {
            // Ignore shutdown
        }
    }

    private async Task SubmitTutorTrialAsync(CancellationToken token)
    {
        if (controlContext is null)
            return;

        await submitLock.WaitAsync(token);
        try
        {
            var parameters = new Dictionary<string, double>
            {
                ["speed"] = controlContext.Frequency,
                ["range"] = controlContext.Amplitude,
                ["baseline_position"] = controlContext.Offset,
                ["relation"] = RadiansToDegrees(controlContext.PhaseShift)
            };

            var submission = new TrialSubmission(
                SessionIdentifier,
                $"run-{Interlocked.Increment(ref runCounter)}",
                DateTimeOffset.UtcNow,
                parameters,
                null,
                controlContext.Frequency,
                LegId,
                null,
                GoalTypes.Speed);

            var response = await TutorManager.SubmitTrialAsync(submission, token);
            if (response is null)
                return;

            tutorStatus = new TutorStatusResponse(
                response.Stuck,
                response.Hint ?? tutorStatus?.LastHint,
                response.HintBudgetRemaining,
                response.HintAvailable,
                response.HintMode,
                response.HintVoteCount,
                response.HintVoteThreshold,
                response.HintVoteTotal,
                response.HintVoted);

            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            submitLock.Release();
        }
    }

    private async Task RequestHint()
    {
        var response = await TutorManager.RequestHintAsync(SessionIdentifier, LegId);
        if (response is null)
            return;

        tutorStatus = new TutorStatusResponse(
            response.Stuck,
            response.Hint ?? tutorStatus?.LastHint,
            response.HintBudgetRemaining,
            response.HintAvailable,
            response.HintMode,
            response.HintVoteCount,
            response.HintVoteThreshold,
            response.HintVoteTotal,
            response.HintVoted);

        await InvokeAsync(StateHasChanged);
    }

    private async Task ReportStuck()
    {
        await TutorManager.ReportStuckAsync(SessionIdentifier, LegId);
        tutorStatus = await TutorManager.GetStatusAsync(SessionIdentifier, LegId);
        await InvokeAsync(StateHasChanged);
    }

    private static double RadiansToDegrees(float radians)
        => radians * 180 / MathF.PI;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await jsRuntime.InvokeVoidAsync("setupUnloadDisposal", objRef);

        await base.OnAfterRenderAsync(firstRender);
    }

    [SupplyParameterFromQuery(Name = "sessionIdentifier")]
    public string SessionIdentifier { get; set; } = "Test";

    [SupplyParameterFromQuery(Name = "name")]
    public string Name { get; set; } = "Test";

    [JSInvokable]
    public void Dispose()
    {
        tutorCts?.Cancel();
        tutorTimer?.Dispose();
        submitLock.Dispose();
        tutorCts?.Dispose();

        controlContext?.Dispose();
        objRef?.Dispose();
    }

}









